{
  "name": "app",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^7.3.0",
    "@popperjs/core": "^2.11.8",
    "@rails/actiontext": "^7.2.301",
    "@stimulus-components/notification": "^3.0.0",
    "@zxing/library": "^0.20.0",
    "autoprefixer": "^10.5.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "esbuild": "^0.19.12",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.16",
    "postcss-cli": "^10.1.0",
    "sass": "^1.101.0",
    "stimulus-notification": "^2.2.0",
    "trix": "^2.1.19",
    "yarn": "^1.22.22"
  },
  "scripts": {
    "build": "bun bun.config.js",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "bun run build:css:compile && bun run build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"bun run build:css\""
  },
  "browserslist": [
    "defaults"
  ]
}
