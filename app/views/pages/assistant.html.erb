<h1 class="text-2xl mt-4 text-info">
    <%= t('assistant.title') %>
</h1>

<h4 class="my-4">
    <%= t('assistant.subtitle') %>
</h4>

<%= form_tag assistant_path, method: :get, class:'w-100 mb-4' do %>
    <div class="d-flex flex-row">
        <div class="w-25 pe-4 mb-2">
            <%= label_tag :table_id, t('misc.table'), class: 'form-label' %>
            <%= select_tag :table_id, 
                            options_from_collection_for_select(current_user.tables.order(:name), 'id', 'name', params[:table_id]), 
                            include_blank: true,
                            class: 'form-select w-100', onchange: 'this.form.submit()', required: true %>
        </div>

        <% if params[:table_id] %>
            <div class="w-25">
                <%= label_tag :fields_ids, t('assistant.source_field'), class: 'form-label' %>
                <%= select_tag :fields_ids, 
                                options_from_collection_for_select(@fields || [], 'id', 'name', params[:fields_ids] || @fields.pluck(:id).take(3)), 
                                class: "form-select w-100", 
                                multiple: true, 
                                required: true,
                                title: t('misc.select_hint') %>
            </div>
        <% end %>
    </div>

    <div>
        <%= label_tag :prompt, t('assistant.question?'), class: "label mb-2" %>
        <%= text_area_tag :prompt, params[:prompt], class: 'form-control w-50', 
                            rows: 2, 
                            required: true, 
                            placeholder: t('assistant.question_hint') %>
    </div>

    <%= submit_tag t('assistant.submit'), class: 'btn btn-outline-info mt-2' %>
<% end %>

<div class="mt-2">
    <% if @results %>
        <h5 class="fst-italic mt-1">
            <span class="text-info">Réponse de l'Assistant : </span>
            <%= simple_format(@results, class: 'mt-3') %>
        </h5>
    <% end %>

    <% if @prompts.any? %>
        <p class="fs-6 fst-italic">Historique des questions posées</p>
        <% @prompts.each do |prompt| %>
            <div>
                <small class="fst-italic text-secondary">il y a <%= time_ago_in_words prompt.created_at %></small>
                <p>
                    <%= link_to prompt.query, assistant_path(prompt: prompt.query, table_id: prompt.table_id, fields_ids: prompt.fields_id) %>
                    <span class="text-secondary">
                        : <%= prompt.response %>
                    </span>
                </p>
            </div>
        <% end %>
    <% end %>

</div>